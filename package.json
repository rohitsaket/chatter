{
  "name": "chatter",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "db:migrate": "pnpm --filter @chatter/database db:migrate",
    "db:seed": "pnpm --filter @chatter/database db:seed"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3",
    "eslint": "^9.39.1",
    "@chatter/eslint-config": "workspace:*"
  },
  "type": "module"
}
