# Database
DATABASE_URL=mysql://chatter:chatter@localhost:3306/chatter

# Redis
REDIS_URL=redis://localhost:6379

# API
API_PORT=4000
API_ORIGIN=http://localhost:4000
WEB_ORIGIN=http://localhost:3000
SESSION_SECRET=change-me-to-a-long-random-string
COOKIE_SECURE=false

# JWT (RS256 only). In production JWT_ACTIVE_PRIVATE_KEY is required and must
# come from a secret manager/KMS integration, never source control. It accepts
# PKCS#8 PEM (with literal \\n) or base64-encoded PEM. Old public keys remain in
# JWT_VERIFICATION_KEYS_JSON as RETIRING until their last token expires.
JWT_ALLOWED_ALGORITHMS=RS256
JWT_ISSUER=https://auth.chatter.local
JWT_ACCESS_AUDIENCE=chatter-api
JWT_REFRESH_AUDIENCE=chatter-auth-refresh
JWT_ACTIVE_KID=KID-2026-01
JWT_ACTIVE_PRIVATE_KEY=
JWT_VERIFICATION_KEYS_JSON=[]
JWT_ACCESS_TTL_SECONDS=600
JWT_REFRESH_TTL_SECONDS=1209600
JWT_CLOCK_TOLERANCE_SECONDS=5

# Object storage (S3-compatible; MinIO in local dev)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=chatter
S3_SECRET_KEY=chatter-secret
S3_BUCKET=chatter-files
# When STORAGE_DRIVER=disk the API stores files on the local filesystem
# (development / test fallback when MinIO is not running).
STORAGE_DRIVER=disk
STORAGE_DISK_ROOT=./var/storage

# LiveKit (calls). Leave empty to run with calls disabled — the UI shows a
# truthful "calls not configured" state instead of simulating a call.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=http://localhost:4000

